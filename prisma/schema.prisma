}

model KeywordPageMappingHistory {
  id         String           @id @default(cuid())
  mappingId  String
  actorId    String?
  action     String
  before     Json?
  after      Json
  note       String?          @db.Text
  createdAt  DateTime         @default(now())
  mapping    KeywordPageMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@index([mappingId, createdAt(sort: Desc)])
}

model ContentVersion {
  id             String       @id @default(cuid())
  organizationId String
  contentPieceId String
  version        Int
  title          String
  url            String?
  body           String?      @db.LongText
  targetKeyword  String?
  status         String
  changeNote     String?      @db.Text
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentPiece   ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  reviews        ContentReview[]

  @@unique([contentPieceId, version])
  @@index([organizationId, contentPieceId, createdAt(sort: Desc)])
}

model ContentReview {
  id             String       @id @default(cuid())
  organizationId String
  contentPieceId String
  versionId      String
  reviewerId     String?
  status         String       @default("PENDING")
  comments       String?      @db.Text
  createdAt      DateTime     @default(now())
  reviewedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentPiece   ContentPiece @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  version        ContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([contentPieceId, versionId, createdAt(sort: Desc)])
}

model CompetitorMonitor {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  websiteId      String
  competitorId   String
  enabled        Boolean      @default(true)
  frequencyHours Int          @default(24)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  website        Domain       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  competitor     Competitor   @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  snapshots      CompetitorPageSnapshot[]
  changes        CompetitorChangeEvent[]

  @@index([organizationId, enabled, nextRunAt])
  @@index([projectId, enabled])
}

model CompetitorPageSnapshot {
  id           String           @id @default(cuid())
  competitorId String
  monitorId    String
  url          String           @db.VarChar(2048)
  observedAt   DateTime         @default(now())
  statusCode   Int?
  title        String?          @db.VarChar(1000)
  description  String?          @db.Text
  h1           String?          @db.VarChar(1000)
  canonical    String?          @db.VarChar(2048)
  robots       String?          @db.VarChar(500)
  contentDigest String?
  headings     Json?
  structuredData Json?
  provider     String           @default("first_party_crawler")
  confidence   DataConfidence   @default(FIRST_PARTY)
  competitor   Competitor      @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  monitor      CompetitorMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  changesBefore CompetitorChangeEvent[] @relation("ChangeBefore")
  changesAfter CompetitorChangeEvent[] @relation("ChangeAfter")

  @@index([competitorId, observedAt(sort: Desc)])
  @@index([monitorId, observedAt(sort: Desc)])
}

model CompetitorChangeEvent {
  id             String                 @id @default(cuid())
  competitorId   String
  monitorId      String
  beforeSnapshotId String?
  afterSnapshotId String
  changeType     String
  risk           String                 @default("LOW")
  status         String                 @default("OPEN")
  evidence       Json
  dedupeKey      String                 @unique
  createdAt      DateTime               @default(now())
  competitor     Competitor            @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  monitor        CompetitorMonitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  beforeSnapshot CompetitorPageSnapshot? @relation("ChangeBefore", fields: [beforeSnapshotId], references: [id], onDelete: SetNull)
  afterSnapshot  CompetitorPageSnapshot @relation("ChangeAfter", fields: [afterSnapshotId], references: [id], onDelete: Cascade)

  @@index([competitorId, status, createdAt(sort: Desc)])
  @@index([monitorId, createdAt(sort: Desc)])
}

model SeoSchedule {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  websiteId      String?
  type           String
  title          String
  timezone       String       @default("UTC")
  recurrence     Json
  payload        Json?
  enabled        Boolean      @default(true)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  website        Domain?      @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  executions     SeoScheduleExecution[]

  @@index([organizationId, enabled, nextRunAt])
  @@index([projectId, enabled, nextRunAt])
}

model SeoScheduleExecution {
  id             String       @id @default(cuid())
  organizationId String
  scheduleId     String
  occurrenceKey  String       @unique
  scheduledAt    DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  status         String       @default("QUEUED")
  attempt        Int          @default(0)
  result         Json?
  error          String?      @db.Text
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule       SeoSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, scheduledAt(sort: Desc)])
  @@index([scheduleId, scheduledAt(sort: Desc)])
}

model BackgroundJob {
  id             String       @id @default(cuid())
  organizationId String
  type           String
  payload        Json
  dedupeKey      String       @unique
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  runAt          DateTime     @default(now())
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
  lockedBy       String?
  error          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  finishedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, runAt, leaseExpiresAt])
  @@index([organizationId, createdAt(sort: Desc)])
}

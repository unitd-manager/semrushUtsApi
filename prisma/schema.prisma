generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Severity {
  CRITICAL
  ERROR
  WARNING
  NOTICE
}

enum BacklinkReviewState {
  NEEDS_REVIEW
  KEEP
  REMOVAL_REQUESTED
  DISAVOW_APPROVED
}

enum DataConfidence {
  FIRST_PARTY
  PROVIDER_OBSERVED
  PROVIDER_ESTIMATE
  USER_ENTERED
  SAMPLE
  UNAVAILABLE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum LeadStage {
  NEW
  QUALIFIED
  CONTACTED
  MEETING
  PROPOSAL
  WON
  LOST
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String
  passwordHash  String
  createdAt     DateTime             @default(now())
  memberships   OrganizationMember[]
  createdTasks  Task[]               @relation("TaskCreator")
  assignedTasks Task[]               @relation("TaskAssignee")
  auditEvents   ActivityLog[]
  backlinkReviews BacklinkReview[]
  createdAgentTasks AgentTask[] @relation("AgentTaskCreator")
  reviewedAgentApprovals AgentApproval[] @relation("AgentApprovalReviewer")
}

model Organization {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  createdAt       DateTime             @default(now())
  members         OrganizationMember[]
  projects        Project[]
  domains         Domain[]
  subscription    Subscription?
  tasks           Task[]
  keywords        Keyword[]
  keywordLists    KeywordList[]
  reports         Report[]
  integrations    Integration[]
  notifications   Notification[]
  workflows       Workflow[]
  leads           Lead[]
  campaigns       Campaign[]
  contentPieces   ContentPiece[]
  apiUsage        ApiUsage[]
  activity        ActivityLog[]
  recommendations Recommendation[]
  localListings   LocalListing[]
  reviews         Review[]
  aiPrompts       AiPrompt[]
  socialAccounts  SocialAccount[]
  aiAgentTasks    AgentTask[]
  aiAgentApprovals AgentApproval[]
  aiAgentSettings AgentSetting[]
  dailySeoBriefingSettings DailySeoBriefingSetting[]
  dailySeoBriefings DailySeoBriefing[]
  seoFixSettings SeoFixCenterSetting[]
  seoFixes SeoFix[]
  seoFixProposals SeoFixProposal[]
  seoFixApprovals SeoFixApproval[]
  seoFixExecutions SeoFixExecution[]
  seoFixSnapshots SeoFixSnapshot[]
  seoFixVerifications SeoFixVerification[]
  seoFixRollbacks SeoFixRollback[]
  seoFixAuditLogs SeoFixAuditLog[]
  reportingClients ClientReportClient[]
  reportBranding ClientReportBranding?
  reportTemplates ClientReportTemplate[]
  clientReports ClientReport[]
  clientReportSchedules ClientReportSchedule[]
  reportDeliveries ClientReportDelivery[]
  reportAccessLogs ClientReportAccessLog[]
  seoOpsProjects SeoOpsProject[]
  seoTasks SeoTask[]
  seoTaskAutomationRules SeoTaskAutomationRule[]
  seoTaskAutomationLogs SeoTaskAutomationLog[]
  seoIntelligenceRecords SeoIntelligenceRecord[]
  keywordPageMappings KeywordPageMapping[]
  contentVersions ContentVersion[]
  contentReviews ContentReview[]
  competitorMonitors CompetitorMonitor[]
  seoSchedules SeoSchedule[]
  backgroundJobs BackgroundJob[]
  seoScheduleExecutions SeoScheduleExecution[]
}

model OrganizationMember {
  organizationId String
  userId         String
  role           MemberRole   @default(ANALYST)
  joinedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId, role])
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  plan                   String             @default("trial")
  status                 SubscriptionStatus @default(TRIAL)
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices               Invoice[]
}

model Invoice {
  id             String       @id @default(cuid())
  subscriptionId String
  amountCents    Int
  currency       String       @default("USD")
  status         String
  externalId     String?      @unique
  issuedAt       DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Project {
  id              String           @id @default(cuid())
  organizationId  String
  name            String
  status          ProjectStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains         Domain[]
  tasks           Task[]
  reports         Report[]
  recommendations Recommendation[]
  aiAgentTasks    AgentTask[]
  aiAgentApprovals AgentApproval[]
  dailySeoBriefingSettings DailySeoBriefingSetting[]
  dailySeoBriefings DailySeoBriefing[]
  seoFixSettings SeoFixCenterSetting[]
  seoFixes SeoFix[]
  clientReportingWebsites ClientReportWebsite[]
  clientReportScheduleWebsites ClientReportScheduleWebsite[]
  reportWebsites ClientReportIncludedWebsite[]
  seoOpsProjects SeoOpsProject[]
  seoIntelligenceRecords SeoIntelligenceRecord[]
  keywordPageMappings KeywordPageMapping[]
  competitorMonitors CompetitorMonitor[]
  seoSchedules SeoSchedule[]

  @@index([organizationId, status, updatedAt])
}

model DailySeoBriefingSetting {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  enabled        Boolean      @default(false)
  hourUtc        Int          @default(8)
  minuteUtc      Int          @default(0)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectId])
  @@index([enabled, nextRunAt])
}

model DailySeoBriefing {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  briefDate      DateTime     @db.Date
  generatedAt    DateTime     @default(now())
  data           Json
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectId, briefDate])
  @@index([organizationId, generatedAt(sort: Desc)])
}

model SeoFixCenterSetting {
  id                  String       @id @default(cuid())
  organizationId      String
  projectId           String
  titleMinLength      Int          @default(30)
  titleMaxLength      Int          @default(60)
  descriptionMinLength Int         @default(120)
  descriptionMaxLength Int         @default(160)
  approvalRequired    Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectId])
}

model SeoFix {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  websiteId      String
  auditIssueId   String
  subresourceKey String       @default("")
  pageUrl        String       @db.VarChar(512)
  issueType      String
  severity       Severity
  status         String       @default("DETECTED")
  detectedAt     DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  website        Domain       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  auditIssue     AuditIssue   @relation(fields: [auditIssueId], references: [id], onDelete: Cascade)
  proposals      SeoFixProposal[]
  approvals      SeoFixApproval[]
  executions     SeoFixExecution[]
  snapshots      SeoFixSnapshot[]
  verifications  SeoFixVerification[]
  rollbacks      SeoFixRollback[]
  auditLogs      SeoFixAuditLog[]

  @@unique([auditIssueId, subresourceKey])
  @@index([organizationId, projectId, status, detectedAt(sort: Desc)])
  @@index([organizationId, issueType, severity])
  @@index([websiteId, pageUrl])
}

model SeoFixProposal {
  id              String       @id @default(cuid())
  organizationId  String
  fixId           String
  version         Int
  originalState   Json
  proposedState   Json
  explanation     String       @db.Text
  expectedBenefit String       @db.Text
  confidence      Float
  riskLevel       String
  evidence        Json
  generatedAt     DateTime     @default(now())
  createdById     String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fix             SeoFix       @relation(fields: [fixId], references: [id], onDelete: Cascade)
  approval        SeoFixApproval?
  executions      SeoFixExecution[]

  @@unique([fixId, version])
  @@index([organizationId, generatedAt(sort: Desc)])
}

model SeoFixApproval {
  id             String       @id @default(cuid())
  organizationId String
  fixId          String
  proposalId     String       @unique
  status         String
  approvedById   String
  comments       String?      @db.Text
  reviewedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fix            SeoFix       @relation(fields: [fixId], references: [id], onDelete: Cascade)
  proposal       SeoFixProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, reviewedAt(sort: Desc)])
}

model SeoFixExecution {
  id                 String       @id @default(cuid())
  organizationId     String
  fixId              String
  proposalId         String
  idempotencyKey     String       @unique
  adapterType        String
  executionStatus    String
  executedById       String
  startedAt          DateTime     @default(now())
  finishedAt         DateTime?
  errorMessage       String?      @db.Text
  verificationStatus String       @default("PENDING")
  result             Json?
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fix                SeoFix       @relation(fields: [fixId], references: [id], onDelete: Cascade)
  proposal           SeoFixProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  snapshot           SeoFixSnapshot?
  verification       SeoFixVerification?
  rollback           SeoFixRollback?

  @@unique([fixId, proposalId])
  @@index([organizationId, executionStatus, startedAt(sort: Desc)])
}

model SeoFixSnapshot {
  id               String       @id @default(cuid())
  organizationId   String
  fixId            String
  executionId      String       @unique
  beforeState      Json
  afterState       Json?
  rollbackSupported Boolean     @default(false)
  snapshotSource   String
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fix              SeoFix       @relation(fields: [fixId], references: [id], onDelete: Cascade)
  execution        SeoFixExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([fixId, createdAt(sort: Desc)])
}

model SeoFixVerification {
  id                 String       @id @default(cuid())
  organizationId     String
  fixId              String
  executionId        String       @unique
  verificationStatus String
  observedState      Json?
  details            String?      @db.Text
  checkedAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fix                SeoFix       @relation(fields: [fixId], references: [id], onDelete: Cascade)
  execution          SeoFixExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([organizationId, verificationStatus, checkedAt(sort: Desc)], map: "SeoFixVerification_org_status_checked_idx")
}

model SeoFixRollback {
  id             String       @id @default(cuid())
  organizationId String
  fixId          String
  executionId    String       @unique
  status         String
  initiatedById  String
  initiatedAt    DateTime     @default(now())
  finishedAt     DateTime?
  result         Json?
  errorMessage   String?      @db.Text
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fix            SeoFix       @relation(fields: [fixId], references: [id], onDelete: Cascade)
  execution      SeoFixExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, initiatedAt(sort: Desc)])
}

model SeoFixAuditLog {
  id             String       @id @default(cuid())
  organizationId String
  fixId          String
  userId         String?
  action         String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fix            SeoFix       @relation(fields: [fixId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([fixId, createdAt(sort: Desc)])
}

model Domain {
  id               String            @id @default(cuid())
  organizationId   String
  projectId        String?
  host             String
  label            String?
  isPrimary        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  competitors      Competitor[]
  crawls           Crawl[]
  rankings         Ranking[]
  backlinks        Backlink[]
  backlinkSnapshots BacklinkSnapshot[]
  keywordPositions KeywordPosition[]
  seoFixes         SeoFix[]
  clientReportingWebsites ClientReportWebsite[]
  reportWebsites ClientReportIncludedWebsite[]
  reportScheduleWebsites ClientReportScheduleWebsite[]
  seoOpsProjects SeoOpsProject[]
  seoIntelligenceRecords SeoIntelligenceRecord[]
  keywordPageMappings KeywordPageMapping[]
  competitorMonitors CompetitorMonitor[]
  seoSchedules SeoSchedule[]

  @@unique([organizationId, host])
  @@index([projectId])
}

model Competitor {
  id        String   @id @default(cuid())
  domainId  String
  host      String
  label     String?
  createdAt DateTime @default(now())
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  snapshots CompetitorSnapshot[]
  monitors CompetitorMonitor[]
  pageSnapshots CompetitorPageSnapshot[]
  changeEvents CompetitorChangeEvent[]

  @@unique([domainId, host])
}

model CompetitorSnapshot {
  id          String       @id @default(cuid())
  competitorId String
  observedAt  DateTime     @default(now())
  kind        String
  location    String
  provider    String
  confidence  DataConfidence
  totalCount  Int?
  metrics     Json
  keywords    Json
  competitor  Competitor   @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, kind, observedAt(sort: Desc)])
}

model Keyword {
  id             String             @id @default(cuid())
  organizationId String
  phrase         String
  locale         String             @default("en-US")
  searchEngine   String             @default("google")
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metrics        KeywordMetric[]
  positions      KeywordPosition[]
  lists          KeywordListEntry[]
  serpResults    SerpResult[]
  pageMappings   KeywordPageMapping[]

  @@unique([organizationId, phrase, locale, searchEngine])
  @@index([organizationId, phrase])
}

model KeywordMetric {
  id           String         @id @default(cuid())
  keywordId    String
  observedAt   DateTime       @default(now())
  searchVolume Int?
  difficulty   Float?
  cpc          Float?
  competition  Float?
  intent       String?
  trend        Json?
  provider     String
  confidence   DataConfidence
  keyword      Keyword        @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, observedAt, provider])
  @@index([keywordId, observedAt(sort: Desc)])
}

model KeywordPosition {
  id         String         @id @default(cuid())
  domainId   String
  keywordId  String
  observedAt DateTime       @default(now())
  position   Int?
  url        String?
  device     String         @default("desktop")
  provider   String
  confidence DataConfidence
  domain     Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  keyword    Keyword        @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([domainId, keywordId, observedAt, device, provider])
  @@index([domainId, observedAt(sort: Desc)])
}

model Ranking {
  id         String         @id @default(cuid())
  domainId   String
  keyword    String
  observedAt DateTime       @default(now())
  position   Int?
  url        String?
  device     String         @default("desktop") @db.VarChar(16)
  location   String         @default("US") @db.VarChar(16)
  provider   String         @db.VarChar(16)
  confidence DataConfidence
  domain     Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, keyword, observedAt, device, location, provider])
  @@index([domainId, observedAt(sort: Desc)])
}

model SerpResult {
  id         String         @id @default(cuid())
  keywordId  String
  observedAt DateTime       @default(now())
  rank       Int
  title      String?
  url        String
  snippet    String?
  features   Json
  provider   String
  confidence DataConfidence
  keyword    Keyword        @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, observedAt(sort: Desc), rank])
}

model KeywordList {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  kind           String             @default("LIST")
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        KeywordListEntry[]

  @@unique([organizationId, name])
  @@index([organizationId, kind])
}

model KeywordListEntry {
  listId    String
  keywordId String
  addedAt   DateTime    @default(now())
  list      KeywordList @relation(fields: [listId], references: [id], onDelete: Cascade)
  keyword   Keyword     @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([listId, keywordId])
}

model Backlink {
  id         String         @id @default(cuid())
  domainId   String
  sourceUrl  String
  targetUrl  String
  anchorText String?
  follow     Boolean?
  firstSeen  DateTime?
  lastSeen   DateTime?
  lostAt     DateTime?
  authority  Float?
  toxicity   Float?
  provider   String
  confidence DataConfidence
  domain     Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  review     BacklinkReview?

  @@unique([domainId, sourceUrl, targetUrl])
  @@index([domainId, lastSeen(sort: Desc)])
}

model BacklinkReview {
  id         String              @id @default(cuid())
  backlinkId String              @unique
  reviewerId String?
  state      BacklinkReviewState @default(NEEDS_REVIEW)
  note       String?
  updatedAt  DateTime            @updatedAt
  backlink   Backlink            @relation(fields: [backlinkId], references: [id], onDelete: Cascade)
  reviewer   User?               @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([state, updatedAt(sort: Desc)])
}

model BacklinkSnapshot {
  id                    String         @id @default(cuid())
  domainId              String
  observedAt            DateTime       @default(now())
  targetRank            Int?
  backlinks             Int?
  referringDomains      Int?
  referringMainDomains  Int?
  referringIps          Int?
  referringPages        Int?
  brokenBacklinks       Int?
  backlinkSpamScore     Int?
  targetSpamScore       Int?
  provider              String
  confidence            DataConfidence
  metrics               Json
  domain                Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, observedAt, provider])
  @@index([domainId, observedAt(sort: Desc)])
}

model Crawl {
  id            String       @id @default(cuid())
  domainId      String
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  status        String       @default("queued")
  pagesCrawled  Int          @default(0)
  issueCounts   Json?
  healthScore   Int?
  configuration Json
  domain        Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  pages         CrawlPage[]
  issues        AuditIssue[]

  @@index([domainId, startedAt(sort: Desc)])
}

model CrawlPage {
  id          String      @id @default(cuid())
  crawlId     String
  url         String
  statusCode  Int?
  title       String?
  titleLength Int?
  description String?
  h1          String?
  canonical   String?
  robots      String?
  indexable   Boolean?
  wordCount   Int?
  loadMs      Int?
  h1Count     Int?
  contentDigest String?
  crawledAt   DateTime    @default(now())
  crawl       Crawl       @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  outgoing    CrawlLink[] @relation("LinkSource")
  incoming    CrawlLink[] @relation("LinkTarget")

  @@unique([crawlId, url])
  @@index([crawlId, statusCode])
}

model CrawlLink {
  id         String     @id @default(cuid())
  sourceId   String
  targetId   String?
  targetUrl  String
  internal   Boolean
  anchorText String?
  source     CrawlPage  @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target     CrawlPage? @relation("LinkTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([sourceId, internal])
  @@index([targetId])
}

model AuditIssue {
  id       String   @id @default(cuid())
  crawlId  String
  pageUrl  String?
  code     String
  severity Severity
  message  String
  details  Json?
  crawl    Crawl    @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  seoFixes SeoFix[]

  @@index([crawlId, severity, code])
}

model Recommendation {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  module         String
  title          String
  description    String
  evidence       Json?
  state          String       @default("open")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, state, createdAt(sort: Desc)])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  title          String
  description    String?
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(NORMAL)
  dueAt          DateTime?
  createdById    String
  assigneeId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id])
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
}

model ContentPiece {
  id             String       @id @default(cuid())
  organizationId String
  sourceId       String?
  format         String       @default("article")
  title          String
  url            String?
  body           String?      @db.Text
  targetKeyword  String?
  status         String       @default("draft")
  score          Float?
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         ContentPiece? @relation("ContentRepurposes", fields: [sourceId], references: [id], onDelete: SetNull)
  variants       ContentPiece[] @relation("ContentRepurposes")
  versions       ContentVersion[]
  reviews        ContentReview[]

  @@index([organizationId, status, updatedAt])
  @@index([sourceId, updatedAt])
}

model LocalListing {
  id             String       @id @default(cuid())
  organizationId String
  createdAt      DateTime     @default(now())
  provider       String
  externalId     String?
  businessName   String
  address        Json
  phone          String?
  url            String?
  lastSyncedAt   DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviews        Review[]

  @@index([organizationId, provider])
}

model Review {
  id             String        @id @default(cuid())
  organizationId String
  listingId      String?
  provider       String
  externalId     String
  rating         Float?
  text           String?
  sentiment      String?
  reviewedAt     DateTime?
